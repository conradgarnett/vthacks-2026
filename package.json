{
  "name": "sense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SENSE: an agent that finds, verifies and translates the world's own perception for people who need another way to perceive it. Hackathon-grade prototype.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "packages/senses/*",
    "apps/*"
  ],
  "scripts": {
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build -w @sense/web",
    "schemas": "tsx scripts/export-schemas.ts",
    "seed": "tsx scripts/seed.ts",
    "world-sim": "tsx apps/world-sim/src/main.ts",
    "server": "tsx apps/server/src/main.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:verify": "tsx scripts/demo-verify.ts",
    "demo:cli": "tsx scripts/demo-cli.ts",
    "create-sense-agent": "tsx scripts/create-sense-agent.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
