{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "readings": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sensorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": [
              "smoke",
              "co",
              "voc",
              "pm25",
              "aqi"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "unit": {
            "type": "string",
            "maxLength": 16
          },
          "measuredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "location": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "y": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "sensorId",
          "kind",
          "value",
          "unit",
          "measuredAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "readings"
  ],
  "additionalProperties": false
}
