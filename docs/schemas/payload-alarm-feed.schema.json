{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "alarms": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "cleared",
              "test"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "fire",
              "smoke",
              "evacuation",
              "other"
            ]
          },
          "zone": {
            "type": "string",
            "maxLength": 80
          },
          "location": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "y": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "raisedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "message": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "id",
          "state",
          "type",
          "zone",
          "location",
          "raisedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "alarms"
  ],
  "additionalProperties": false
}
