                            "maxItems": 8,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            }
                          },
                          "safetyCritical": {
                            "type": "boolean"
                          },
                          "safetyNote": {
                            "type": "string",
                            "maxLength": 300
                          },
                          "subscribable": {
                            "type": "boolean"
                          }
                        },
