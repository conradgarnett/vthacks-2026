{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "devices": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": [
              "elevator"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "state": {
            "type": "string",
            "maxLength": 80
          },
          "actions": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "call"
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "state",
          "actions"
        ],
        "additionalProperties": false
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "ok",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "devices"
  ],
  "additionalProperties": false
}
