{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "sense-card/0.1"
    },
    "agent": {
      "type": "object",
      "properties": {
        "fqdn": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "operator": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "fqdn",
        "version",
        "digest",
        "name"
      ],
      "additionalProperties": false
    },
    "simulated": {
      "type": "boolean"
    },
    "capabilities": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "indoor-map",
              "alarm-feed",
              "air-quality",
              "menu-allergens",
              "arrivals",
              "accessibility-features",
              "device-control"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "basis": {
            "type": "string",
            "enum": [
              "direct-sensor",
              "staff-entered",
              "inferred",
              "static"
            ]
          },
          "freshness": {
            "type": "object",
            "properties": {
              "maxAgeSeconds": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31536000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "maxAgeSeconds"
            ],
            "additionalProperties": false
          },
          "scopes": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "safetyCritical": {
            "type": "boolean"
          },
          "safetyNote": {
            "type": "string",
            "maxLength": 300
          },
          "subscribable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "summary",
          "basis",
          "freshness",
          "scopes",
          "safetyCritical"
        ],
        "additionalProperties": false
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "agent",
    "capabilities",
    "issuedAt"
  ],
  "additionalProperties": false
}
