{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "floor": {
      "type": "string",
      "maxLength": 16
    },
    "nodes": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "kind": {
            "type": "string",
            "enum": [
              "entrance",
              "exit",
              "stairs",
              "lift",
              "room",
              "corridor",
              "assembly-point"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "maxItems": 400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "meters": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "from",
          "to",
          "meters"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "floor",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
