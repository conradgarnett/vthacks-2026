# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# You do NOT need an API key if you run `ant auth login` -- the SDK reads the
# OAuth profile from ~/.config/anthropic/ automatically. Set this ONLY if you
# are using a raw API key instead.
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
MEDIGLASSES_MODEL=claude-sonnet-5
MEDIGLASSES_EFFORT=low
MEDIGLASSES_MAX_TOKENS=1024

# "claude" = live API. "nvidia" = an NVIDIA-hosted vision model answers
# questions (Ask), scans and reads stay on-device. "replay" = canned scenes,
# no credentials, no network.
VISION_PROVIDER=claude
# For VISION_PROVIDER=nvidia: a key from build.nvidia.com, and the model to
# ask. Any vision model in NVIDIA's list works; the backend log says at
# startup whether the key and the model were accepted.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# ---------------------------------------------------------------------------
# Local perception
# ---------------------------------------------------------------------------
# "open" runs YOLO-World on the vocabulary in backend/perception/vocabulary.py
# (doors, stairs, handrails). "coco" falls back to a fixed checkpoint.
DETECTOR_MODE=open
OPEN_VOCAB_WEIGHTS=yolov8s-world.pt
DETECTOR_WEIGHTS=yolo11m.pt
DETECTOR_CONFIDENCE=0.30
# Detector labels to see as something else, "seen:spoken" pairs separated by
# commas, applied before distance and speech. A venue whose tall bins read as
# refrigerators runs SEE_AS=refrigerator:trash can; a real kitchen must not.
# SEE_AS=
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
CAMERA_HFOV_DEG=66.0
PERCEPTION_DEVICE=auto

# ---------------------------------------------------------------------------
# Text reading
# ---------------------------------------------------------------------------
# auto | apple-vision | rapidocr | none. "auto" takes the first engine that
# loads. "none" sends every read to the vision provider.
OCR_ENGINE=auto

# ---------------------------------------------------------------------------
# Hazards (safety-critical path)
# ---------------------------------------------------------------------------
# Off while the detection vocabulary is being tuned -- false warnings talk
# over everything else. Set true to re-arm; the engine is intact and tested.
HAZARDS_ENABLED=false
HAZARD_DISTANCE_M=1.5
HAZARD_CONE_DEG=30.0
HAZARD_COOLDOWN_S=3.0
# Alerts need more evidence than descriptions: frames of persistence and a
# confidence floor above the detector's own recall-tuned threshold.
HAZARD_MIN_HITS=3
HAZARD_MIN_CONFIDENCE=0.45

# ---------------------------------------------------------------------------
# Places -- every scan is remembered; alike scenes become one named place
# ---------------------------------------------------------------------------
# "It looks like you are in Hallway 1" is spoken at or above the match bar
# (the user's 80% rule); below PLACE_NEW_BELOW a scan starts a new place; in
# between nothing is said and the Places panel offers the link. The file is
# this machine's memory; the panel deletes, renames and links places.
PLACES_ENABLED=true
PLACES_FILE=data/places.json
PLACE_MATCH_CONFIDENCE=0.80
PLACE_NEW_BELOW=0.50

# ---------------------------------------------------------------------------
# Speech -- "browser" needs no keys and survives a dead network
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# A rehearsal label (leave empty outside a demo)
# ---------------------------------------------------------------------------
# When set, a Read looking at a pill bottle, or whose text matches this
# label's own name or drug, speaks this sentence instead of the OCR. A canned
# dose spoken over a different bottle is the failure this project is built to
# avoid, so this is empty everywhere but one demo machine. The same sentence
# can sit in data/demo_label.txt (gitignored) instead.
# DEMO_LABEL=Jane Doe. Example 10 mg tablet. Take 1 tablet by mouth daily.
# DEMO_LABEL_HOLDERS=pill bottle,bottle

# ---------------------------------------------------------------------------
# The food allergy scanner and the email to the doctor
# ---------------------------------------------------------------------------
# The wearer's allergies, name and doctor's address live in data/profile.json
# (gitignored), edited from the Allergies sheet. The scanner runs whenever
# that file lists an allergen. Evidence, strongest first: a barcode looked up
# in Open Food Facts, a CONTAINS line the reader was 80% sure of across two
# frames, the label's text judged online (VISION_PROVIDER=nvidia); a food the
# detector sees is only a trigger. The doctor is emailed on the first two.
ALLERGY_ALERTS_ENABLED=true
PROFILE_FILE=data/profile.json
ALLERGY_MIN_CONFIDENCE=0.80
ALLERGY_MIN_AGREEMENT=2
ALLERGY_COOLDOWN_S=600
BARCODE_LOOKUP_ENABLED=true
# Sending needs a Gmail app password (myaccount.google.com > Security > App
# passwords) for the sending account. Without these two lines every alert is
# written to data/outbox/ instead and the wearer hears that mail is not set
# up. The doctor's address in the profile wins over ALERT_EMAIL_TO.
# ALERT_SMTP_USER=you@gmail.com
# ALERT_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# ALERT_EMAIL_TO=doctor@example.com
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEMO_MODE=false
LOG_LEVEL=INFO

# ElevenLabs speaks answers and reads; hazards stay on the browser's
# offline voice. Empty disables it and the client uses its own voice
# for everything -- the app is fully functional without a key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5
