# SENSE configuration. Copy to .env if you want to change defaults. Nothing here is required.

# AI provider for vision / taste reasoning: anthropic | mock
# Defaults to "anthropic" only if ANTHROPIC_API_KEY is set, otherwise "mock" (labelled MOCK AI in the UI).
SENSE_PROVIDER=mock
ANTHROPIC_API_KEY=
# Model used by the anthropic provider.
SENSE_MODEL=claude-sonnet-5

# Identity mode: simulated (default, "ANS-modeled") | live (typed stub, throws NotConfigured)
ANS_MODE=simulated

# Ports (0 = pick a free port automatically and print it)
SENSE_SERVER_PORT=8787
SENSE_WORLD_SIM_PORT=8788
SENSE_WEB_PORT=5173

# Where the local dev CA / log keys live (gitignored)
SENSE_KEY_DIR=.sense/keys

# Optional: fetch real air-quality data when online (otherwise cached fixtures are used and labelled)
SENSE_LIVE_AIR=0
