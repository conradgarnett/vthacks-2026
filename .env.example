# SENSE configuration. Copy to .env if you want to change defaults. Nothing here is required:
# with no configuration everything runs offline against the simulated world with mock AI.

# AI provider for vision / taste reasoning: mock | anthropic
# Default: "anthropic" only if ANTHROPIC_API_KEY is set (and SENSE_PROVIDER is not "mock"), otherwise "mock"
# (shown as MOCK AI in the UI). The Anthropic client is implemented but was NOT exercised against the live API.
SENSE_PROVIDER=mock
ANTHROPIC_API_KEY=
# Model used by the anthropic provider.
SENSE_MODEL=claude-sonnet-5

# Identity mode: simulated (default, "ANS-modeled") | live (a typed stub that throws NotConfigured)
ANS_MODE=simulated

# Ports (the server picks a free port and prints it if these are busy)
SENSE_SERVER_PORT=8787
SENSE_WORLD_SIM_PORT=8788
SENSE_WEB_PORT=5173

# Where the local dev CA and transparency-log keys live (gitignored; never commit them)
SENSE_KEY_DIR=.sense/keys

# Skip the one optional connectivity ping at startup (1 = stay fully offline)
SENSE_OFFLINE=0

# Demo mode (set by `npm run demo`): scripted scenes, simulated time skips, offset clock
SENSE_DEMO=0
