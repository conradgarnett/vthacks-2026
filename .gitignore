.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

node_modules/
dist/
*.local

# Model weights -- pulled by `make precache`, never committed
*.pt
*.onnx
.cache/

.DS_Store
*.log
eval/data/

# The downloaded COCO slice for eval/run_detect_eval.py (eval/fetch_everyday.py), 95 MB
med-i-glasses/eval/data/coco_everyday/

# The OCR recognition model and its character list (backend/ai/ocr_models.py).
med-i-glasses/weights/ocr/

# The place memory each machine builds for itself (backend/scene/places.py)
med-i-glasses/data/
# Rendered speech: derived from the phrase list, re-creatable with
# eval/warm_voice.py, and large. Never committed.
med-i-glasses/data/voice_cache/

# Vite's dependency cache, never committed.
med-i-glasses/client/.vite/

# arduino-cli build cache inside a sketch folder.
med-i-glasses/hardware/**/build/

# The full render of the dataset (dataset/generate.py), 98 MB; reproducible.
dataset/out/
# Real photographs fetched by dataset/fetch_real.py; the labels beside them are committed.
dataset/real/*/images/
