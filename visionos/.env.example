# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# You do NOT need an API key if you run `ant auth login` -- the SDK reads the
# OAuth profile from ~/.config/anthropic/ automatically. Set this ONLY if you
# are using a raw API key instead.
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
VISIONOS_MODEL=claude-sonnet-5
VISIONOS_MODEL_HEAVY=claude-opus-5
VISIONOS_EFFORT=low
VISIONOS_MAX_TOKENS=1024

# "claude" = live API. "replay" = canned scenes, no credentials, no network.
VISION_PROVIDER=claude

# ---------------------------------------------------------------------------
# Local perception
# ---------------------------------------------------------------------------
DETECTOR_WEIGHTS=yolo11n.pt
DETECTOR_CONFIDENCE=0.35
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
CAMERA_HFOV_DEG=66.0
PERCEPTION_DEVICE=auto

# ---------------------------------------------------------------------------
# Hazards (safety-critical path)
# ---------------------------------------------------------------------------
# Off while the detection vocabulary is being tuned -- false warnings talk
# over everything else. Set true to re-arm; the engine is intact and tested.
HAZARDS_ENABLED=false
HAZARD_DISTANCE_M=1.5
HAZARD_CONE_DEG=30.0
HAZARD_COOLDOWN_S=3.0
# Alerts need more evidence than descriptions: frames of persistence and a
# confidence floor above the detector's own recall-tuned threshold.
HAZARD_MIN_HITS=3
HAZARD_MIN_CONFIDENCE=0.35

# ---------------------------------------------------------------------------
# Speech -- "browser" needs no keys and survives a dead network
# ---------------------------------------------------------------------------
TTS_PROVIDER=browser
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEMO_MODE=false
LOG_LEVEL=INFO
